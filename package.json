{
  "name": "brain-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "format": "prettier --write src/**/*.{ts,tsx,scss}",
    "check": "npm run lint && npm run typecheck && npm test",
    "check:cloud": "cd cloud && npm run check && npm test",
    "deploy:cloud": "cd cloud && npm run deploy",
    "smoke:cloud": "node cloud/scripts/smoke.mjs",
    "icons": "pwa-assets-generator",
    "snap": "node scripts/snap.mjs",
    "logos": "node scripts/logo-sheet.mjs",
    "i18n:merge": "node scripts/i18n-merge.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "i18next": "^25.7.3",
    "qrcode-generator": "^2.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^23.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
